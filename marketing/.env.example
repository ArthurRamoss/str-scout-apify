# Copy to marketing/.env (which is gitignored) and fill before running scripts.
# Each section unlocks a different distribution channel. Missing = that channel skipped.

# === Reddit (script-app credentials) ===
# Create at https://www.reddit.com/prefs/apps → "create another app" → script
# Use an account with real history (not a fresh one — looks botty)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# Optional: comma-separated list of subreddits to target (default: see reddit-submit.sh)
REDDIT_SUBREDDITS=

# === GitHub (PAT with public_repo scope) ===
# Create at https://github.com/settings/tokens/new — fine-grained, 30-day expiry fine
GITHUB_PAT=
GITHUB_USER=ArthurRamoss

# === Twitter / X (OAuth 1.0a v2 API) ===
# Create at https://developer.twitter.com → New Project → Free tier
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# === Apify (for cross-posting from Standby URL) — should already be in your env from the main project ===
APIFY_TOKEN=
STARTER_APIFY_TOKEN=

# === Optional: browser-automation cookie file paths (one JSON per site) ===
# Export using EditThisCookie or "Cookie-Editor" Chrome extension
COOKIES_YOUTUBE=./marketing/cookies/youtube.json
COOKIES_FACEBOOK=./marketing/cookies/facebook.json
COOKIES_LINKEDIN=./marketing/cookies/linkedin.json
COOKIES_QUORA=./marketing/cookies/quora.json
COOKIES_BIGGERPOCKETS=./marketing/cookies/biggerpockets.json
COOKIES_G2=./marketing/cookies/g2.json
COOKIES_CAPTERRA=./marketing/cookies/capterra.json
COOKIES_AIRDNA=./marketing/cookies/airdna.json
